[sub_resource type="Shader" id="Shader_ha31o"]
code = "shader_type canvas_item;

uniform float intensity : hint_range(0.0, 1.0) = 0.0;

float rand(vec2 co) {
	return fract(sin(dot(co, vec2(12.9898, 78.233))) * 43758.5453);
}

void fragment() {
	// ก้อนสัญญาณรบกวนหยาบๆ เปลี่ยนทุก 1/24 วินาที
	vec2 cell = floor(UV * vec2(320.0, 180.0));
	float n = rand(cell + vec2(floor(TIME * 24.0)));

	// เส้นสแกนแนวนอนวิ่งเบาๆ
	float scan = sin(UV.y * 500.0 + TIME * 40.0) * 0.5 + 0.5;
	n *= mix(0.75, 1.0, scan);

	COLOR = vec4(vec3(n), intensity * 0.85);
}"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_13qdw"]
shader = SubResource("Shader_ha31o")
shader_parameter/intensity = 0.0

